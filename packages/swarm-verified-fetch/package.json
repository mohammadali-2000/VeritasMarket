{
  "name": "@veritas-market/swarm-verified-fetch",
  "version": "0.1.0",
  "description": "Fetch-shaped Swarm gateway reads with client-side verification.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "browser": "./dist/index.js",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "swarm",
    "bee",
    "verified-fetch",
    "gateway",
    "bmt",
    "cac",
    "soc",
    "feeds"
  ],
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": ">=20.0.0 <25",
    "tsup": ">=8.0.0 <9",
    "typescript": ">=5.0.0 <6",
    "vitest": ">=3.0.0 <5"
  }
}
